# Local environment variables. .env is NOT automatically loaded.
# Never commit real API tokens or websocket credentials.
X_API_BEARER_TOKEN=
RADAR_FOLLOWER_THRESHOLD=10000
RADAR_X_LOOKUPS_PER_15M=15
RADAR_PORT=4174
# Optional vetted public metadata gateway hostnames, comma-separated:
RADAR_METADATA_HOSTS=
# Optional secure Solana provider WSS. Default: public mainnet.
SOLANA_WS_URL=wss://api.mainnet.solana.com/
